<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Texto ===== -->
  <Style Selector="TextBlock.titulo">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="TextBlock.subtitulo">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
  </Style>
  <Style Selector="TextBlock.seccion">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{DynamicResource Cobre}" />
  </Style>
  <Style Selector="TextBlock.etiqueta">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
  </Style>
  <Style Selector="TextBlock.valor">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="TextBlock.grande">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="TextBlock.cifra">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
  </Style>
  <Style Selector="TextBlock.suave">
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
  </Style>
  <Style Selector="TextBlock.negrita">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== Tarjetas ===== -->
  <Style Selector="Border.tarjeta">
    <Setter Property="Background" Value="{DynamicResource FondoTarjeta}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22,20" />
  </Style>
  <Style Selector="Border.hundido">
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.aviso-caja">
    <Setter Property="Background" Value="{StaticResource TinteAviso}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.hundido.ok-caja">
    <Setter Property="Background" Value="{StaticResource TinteOk}" />
  </Style>

  <!-- ===== Chips de estado ===== -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.ok">
    <Setter Property="Background" Value="{StaticResource TinteOk}" />
  </Style>
  <Style Selector="Border.chip.ok TextBlock">
    <Setter Property="Foreground" Value="{StaticResource EstadoOk}" />
  </Style>
  <Style Selector="Border.chip.aviso">
    <Setter Property="Background" Value="{StaticResource TinteAviso}" />
  </Style>
  <Style Selector="Border.chip.aviso TextBlock">
    <Setter Property="Foreground" Value="{StaticResource EstadoAviso}" />
  </Style>
  <Style Selector="Border.chip.fallo">
    <Setter Property="Background" Value="{StaticResource TinteFallo}" />
  </Style>
  <Style Selector="Border.chip.fallo TextBlock">
    <Setter Property="Foreground" Value="{StaticResource EstadoFallo}" />
  </Style>

  <Style Selector="Ellipse.punto">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource EstadoPendiente}" />
  </Style>
  <Style Selector="Ellipse.punto.ok">
    <Setter Property="Fill" Value="{StaticResource EstadoOk}" />
  </Style>
  <Style Selector="Ellipse.punto.aviso">
    <Setter Property="Fill" Value="{StaticResource EstadoAviso}" />
  </Style>
  <Style Selector="Ellipse.punto.fallo">
    <Setter Property="Fill" Value="{StaticResource EstadoFallo}" />
  </Style>

  <!-- ===== Barra lateral ===== -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Serigrafia}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource MascaraClara}" />
    <Setter Property="Foreground" Value="{StaticResource Serigrafia}" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource MascaraClara}" />
    <Setter Property="Foreground" Value="{StaticResource Serigrafia}" />
  </Style>
  <Style Selector="Button.nav.activo /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource MascaraClara}" />
  </Style>
  <Style Selector="Button.nav Border.marca">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav.activo Border.marca">
    <Setter Property="Background" Value="{StaticResource CobreBrillo}" />
  </Style>
  <Style Selector="Path.icono-nav">
    <Setter Property="Stroke" Value="{StaticResource SerigrafiaSuave}" />
  </Style>
  <Style Selector="Button.nav.activo Path.icono-nav">
    <Setter Property="Stroke" Value="{StaticResource CobreBrillo}" />
  </Style>

  <!-- ===== Revisión completa: barra de la guía ===== -->
  <Style Selector="Border.guia">
    <Setter Property="Background" Value="{DynamicResource FondoTarjeta}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="40,12,40,12" />
  </Style>
  <Style Selector="Border.segmento">
    <Setter Property="Background" Value="{DynamicResource Borde}" />
    <Setter Property="Width" Value="18" />
  </Style>
  <Style Selector="Border.segmento.ok">
    <Setter Property="Background" Value="{StaticResource EstadoOk}" />
  </Style>
  <Style Selector="Border.segmento.aviso">
    <Setter Property="Background" Value="{StaticResource EstadoAviso}" />
  </Style>
  <Style Selector="Border.segmento.fallo">
    <Setter Property="Background" Value="{StaticResource EstadoFallo}" />
  </Style>
  <Style Selector="Border.segmento.actual">
    <Setter Property="Background" Value="{DynamicResource Cobre}" />
    <Setter Property="Width" Value="30" />
  </Style>
  <Style Selector="Button.secundario.actual">
    <Setter Property="BorderBrush" Value="{DynamicResource Cobre}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- Lo que prueba Bancada sola mientras el técnico hace los pasos -->
  <Style Selector="Border.fondo-revision">
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.fondo-revision ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Cobre}" />
  </Style>
  <Style Selector="Border.fondo-revision Border.chip:not(.ok):not(.aviso):not(.fallo)">
    <Setter Property="Background" Value="{DynamicResource FondoTarjeta}" />
  </Style>
  <Style Selector="Border.chip.actual">
    <Setter Property="BorderBrush" Value="{DynamicResource Cobre}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.chip.actual TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Cobre}" />
  </Style>

  <!-- ===== Botones ===== -->
  <Style Selector="Button.primario">
    <Setter Property="Background" Value="{DynamicResource Cobre}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="20,11" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource CobreBrillo}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primario:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="Foreground" Value="{DynamicResource TintaSuave}" />
  </Style>
  <Style Selector="Button.secundario">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Borde}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.secundario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Cobre}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>

  <!-- Veredicto: Funciona / Con defectos / No funciona -->
  <Style Selector="Button.veredicto">
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.veredicto:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Borde}" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
  </Style>
  <Style Selector="Button.veredicto.ok.elegido">
    <Setter Property="Background" Value="{StaticResource EstadoOk}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.veredicto.ok.elegido:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EstadoOk}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.veredicto.aviso.elegido">
    <Setter Property="Background" Value="{StaticResource EstadoAviso}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.veredicto.aviso.elegido:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EstadoAviso}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.veredicto.fallo.elegido">
    <Setter Property="Background" Value="{StaticResource EstadoFallo}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.veredicto.fallo.elegido:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource EstadoFallo}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ===== Teclado ===== -->
  <Style Selector="Border.tecla">
    <Setter Property="Background" Value="{DynamicResource TeclaFondo}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeclaBorde}" />
    <Setter Property="BorderThickness" Value="1,1,1,3" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.tecla TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Tinta}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tecla.pulsada">
    <Setter Property="Background" Value="{StaticResource EstadoOk}" />
    <Setter Property="BorderBrush" Value="#1F7A42" />
  </Style>
  <Style Selector="Border.tecla.pulsada TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.tecla.activa">
    <Setter Property="Background" Value="{DynamicResource Cobre}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Cobre}" />
  </Style>
  <Style Selector="Border.tecla.activa TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Barras de señal -->
  <Style Selector="Border.barra-fondo">
    <Setter Property="Background" Value="{DynamicResource FondoHundido}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Height" Value="6" />
  </Style>
  <Style Selector="Border.barra.ok">
    <Setter Property="Background" Value="{StaticResource EstadoOk}" />
  </Style>
  <Style Selector="Border.barra.aviso">
    <Setter Property="Background" Value="{StaticResource EstadoAviso}" />
  </Style>
  <Style Selector="Border.barra.fallo">
    <Setter Property="Background" Value="{StaticResource EstadoFallo}" />
  </Style>
</Styles>
