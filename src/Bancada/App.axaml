<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bancada.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Bancada/Estilo/Colores.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#B5642A" RegionColor="#F4F2ED" />
        <ColorPaletteResources x:Key="Dark" Accent="#E09A5C" RegionColor="#111513" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Bancada/Estilo/Estilos.axaml" />
  </Application.Styles>
</Application>
